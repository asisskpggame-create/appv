# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# ASIS_JWT_SECRET: REQUIRED in production. Random string, at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ASIS_JWT_SECRET=

# ASiS Client Gateway - Server-side integration variables (NEVER prefix with VITE_)
# PASARGUARD_BASE_URL: panel URL. With only this set, subscription-link login works (no admin token needed).
PASARGUARD_BASE_URL=
# PASARGUARD_SUBSCRIPTION_BASE_URL: public subscription prefix users paste, e.g. https://sub.example.com:8443/sub
# (default: PASARGUARD_BASE_URL + /sub). Links on any other host are refused.
PASARGUARD_SUBSCRIPTION_BASE_URL=
PASARGUARD_SERVICE_TOKEN=
PASARGUARD_INSTANCES_JSON=
# Reseller/bot endpoint that implements POST /verify-login (see RESELLER_INTEGRATION.md)
RESELLER_BASE_URL=
RESELLER_API_KEY=
# ASIS_DB_PATH: SQLite file for sessions, devices and imported subscriptions (e.g. ./data/asis.db).
# Unset = in memory (everyone is logged out on every restart). Run ONE gateway process per file.
ASIS_DB_PATH=
# ASIS_DB_KEY: optional separate key (>= 32 chars) that encrypts stored subscription URLs.
# Falls back to ASIS_JWT_SECRET. Changing it makes already-stored URLs unreadable.
ASIS_DB_KEY=
# ASIS_ALLOWED_ORIGINS: extra CORS origins, comma separated. The Capacitor app origins
# (https://localhost, http://localhost, capacitor://localhost) are always allowed.
ASIS_ALLOWED_ORIGINS=
ASIS_MIN_SUPPORTED_VERSION="0.3.0"
ASIS_LATEST_VERSION="0.3.0"

# Operator key for /api/v1/admin/* (create/unlock gateway accounts). 32+ random chars; leave empty to disable.
ADMIN_API_KEY=
